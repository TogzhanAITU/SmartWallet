@page "/expenses"
@inject BudgetState State
@implements IDisposable

<PageTitle>Expenses · Budget Summary</PageTitle>
<h1 class="page-title">Expenses</h1>

<ExpenseForm />

<div class="card">
    <div class="card-head">
        <h3>Expenses (@State.Expenses.Count)</h3>
        <div style="display:flex; gap:.5rem;">
            <button class="btn btn-secondary btn-sm" @onclick="State.LoadSampleData">Load Sample</button>
            @if (State.Expenses.Any())
            {
                <button class="btn btn-danger btn-sm" @onclick="State.ClearAll">Clear All</button>
            }
        </div>
    </div>
    <ExpenseTable />
</div>

@code {
    protected override void OnInitialized() => State.OnChange += HandleChange;
    private void HandleChange() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.OnChange -= HandleChange;
}