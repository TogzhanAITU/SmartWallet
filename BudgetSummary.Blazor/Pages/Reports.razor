@page "/reports"
@inject BudgetState State
@implements IDisposable

<PageTitle>Reports · Budget Summary</PageTitle>
<h1 class="page-title">Reports</h1>

@if (!State.Expenses.Any())
{
    <div class="empty">
        <div class="empty-icon">📈</div>
        <h2>No data yet</h2>
        <p>Add expenses (or load sample data) to generate reports.</p>
        <div style="display:flex; gap:.75rem; justify-content:center; margin-top:1rem;">
            <NavLink href="expenses" class="btn btn-primary">Add Expense →</NavLink>
            <button class="btn btn-secondary" @onclick="State.LoadSampleData">Load Sample Data</button>
        </div>
    </div>
}
else
{
    <div class="card">
        <h3>Configuration</h3>
        <div class="controls-grid">
            <div class="field">
                <label>Native Tax Rate (BPS)</label>
                <select class="input" @bind="TaxBps">
                    <option value="0">0 bps (0%)</option>
                    <option value="100">100 bps (1%)</option>
                    <option value="250">250 bps (2.5%)</option>
                    <option value="500">500 bps (5%)</option>
                    <option value="1000">1000 bps (10%)</option>
                </select>
            </div>
            <div class="field">
                <label>Score Preset</label>
                <select class="input" @bind="ScorePreset">
                    <option value="conservative">Conservative (amount×1, mandatory+10)</option>
                    <option value="aggressive">Aggressive (amount×2, mandatory+10)</option>
                </select>
            </div>
            <div class="field">
                <label>Min Priority Score: @State.MinPriorityScore</label>
                <input type="range" min="0" max="500" step="10"
                       value="@State.MinPriorityScore"
                       @oninput="e => State.SetMinPriorityScore(ParseInt(e.Value))" />
            </div>
        </div>
    </div>

    <div class="card">
        <h3>Tax Policy Comparison <span class="muted">(per TaxPolicyLookup + ApplyTaxPolicy)</span></h3>
        <div class="policy-grid">
            @foreach (var policy in new[] { "Standard", "Discount", "Increase" })
            {
                var r = State.TotalUnderTaxPolicy(policy);
                <div class="policy-card">
                    <div class="policy-name">@policy</div>
                    @if (r.IsSuccess)
                    {
                        <div class="policy-total">@r.Value.ToString("C")</div>
                    }
                    else
                    {
                        <div class="policy-error">@r.Error.Code</div>
                    }
                </div>
            }
        </div>
    </div>

    <CategorySummary Result="@State.CategoryReport()" TaxBps="@State.TaxBps" />
    <PriorityTable  Result="@State.PriorityReport()" MinScore="@State.MinPriorityScore" />
}

@code {
    private int TaxBps
    {
        get => State.TaxBps;
        set => State.SetTaxBps(value);
    }

    private string ScorePreset
    {
        get => State.ScorePresetName;
        set => State.SetScorePreset(value);
    }

    private static int ParseInt(object? value) =>
        int.TryParse(value?.ToString(), out var n) ? n : 0;

    protected override void OnInitialized() => State.OnChange += HandleChange;
    private void HandleChange() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.OnChange -= HandleChange;
}