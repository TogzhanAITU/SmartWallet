@if (!string.IsNullOrEmpty(Message))
{
    <div class="result-banner result-@Kind" role="alert">
        <span>@(Kind == "error" ? "✗" : Kind == "success" ? "✓" : "ℹ")</span>
        <span>@Message</span>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Kind { get; set; } = "info";
}